# Campus Köthen – News & Events
# Kopiere diese Datei nach .env und passe die Werte an:  cp .env.example .env

# Basis-Adresse (Origin, ohne Pfad und ohne abschließenden Slash) der Campus-Köthen-API.
# Die Website ruft die API nicht direkt aus dem Browser auf, sondern über den
# eingebauten nginx-Proxy unter /api/ – so gibt es keine CORS-Probleme und die
# IP-Adressen der Besucher*innen werden nicht an die API weitergegeben.
API_BASE_URL=https://campus-koethen-api.sturahsa.de

# Image-Version aus der GitHub Container Registry (z. B. 1.0.0, 1.0, 1 oder latest)
IMAGE_TAG=latest

# Adresse/Port, unter dem der Container auf dem Host erreichbar ist.
# 127.0.0.1 = nur lokal (für einen Reverse Proxy auf demselben Server, empfohlen).
# 0.0.0.0   = von außen erreichbar.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
