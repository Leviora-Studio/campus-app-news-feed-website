# Campus Köthen – News & Events
# Rendered at container start by the nginx image (envsubst) into /etc/nginx/conf.d/.
# Only environment variables that are actually set are substituted, nginx's own
# $variables stay untouched. The API upstream itself lives in api-proxy.inc.template.

# --- basic protection of the upstream API ---------------------------------------
limit_req_zone $binary_remote_addr zone=campus_api_rl:10m rate=15r/s;

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;
    server_tokens off;

    # No request logging at all. Only critical server errors (e.g. nginx cannot
    # start) are written; these contain no visitor data.
    access_log off;
    error_log  /dev/stderr crit;

    # Behind a reverse proxy on the same host / Docker network: use the real client IP
    # (only in memory for rate limiting – never logged, never forwarded upstream).
    set_real_ip_from 127.0.0.1;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from ::1;
    set_real_ip_from fc00::/7;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json text/plain;
    gzip_min_length 512;

    error_page 404 /404.html;

    # ------------------------------------------------------------------ health
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ------------------------------------------------------------- API proxy
    # Only the read-only endpoints the website needs are forwarded. The client's
    # IP address, cookies and referrer are NOT passed on to the API.
    location /api/ {
        limit_except GET { deny all; }
        limit_req zone=campus_api_rl burst=60 nodelay;
        limit_req_status 429;

        location ~ ^/api/v1/(posts|posts/channels|posts/tags|environment|calendars|calendars/events)$ {
            limit_except GET { deny all; }
            limit_req zone=campus_api_rl burst=60 nodelay;
            include /etc/nginx/conf.d/api-proxy.inc;
            include /etc/nginx/snippets/security-headers.conf;
        }

        location ~ ^/api/v1/posts/[A-Za-z0-9._-]+$ {
            limit_except GET { deny all; }
            limit_req zone=campus_api_rl burst=60 nodelay;
            include /etc/nginx/conf.d/api-proxy.inc;
            include /etc/nginx/snippets/security-headers.conf;
        }

        location ~ ^/api/v1/media/uploads/[A-Za-z0-9._-]+$ {
            limit_except GET { deny all; }
            limit_req zone=campus_api_rl burst=120 nodelay;
            include /etc/nginx/conf.d/api-proxy.inc;
            include /etc/nginx/snippets/security-headers.conf;
        }

        return 404;
    }

    # ------------------------------------------------------------ static site
    # "no-cache" = the browser may keep a copy but must revalidate it (cheap 304
    # via ETag) on every load, so a new deployment is visible immediately.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location = /LICENSE {
        default_type text/plain;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location /assets/ {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location ~* \.(?:png|ico|webmanifest)$ {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
